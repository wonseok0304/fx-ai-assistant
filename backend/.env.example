# --- OpenAI ---
OPENAI_API_KEY=sk-...
# 유료 OpenAI 사용 시 아래 BASE_URL은 비워 둔다.
# 무료(Gemini) 사용 시: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ , OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# --- Firebase (둘 중 하나) ---
# 1) 서비스 계정 JSON 전체를 한 줄 문자열로 (Render 배포 시 권장)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) 로컬 개발용 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- CORS (쉼표 구분, 프론트 도메인) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 로컬 UI 테스트용: true면 Firestore 대신 메모리 DB 사용 (배포 금지)
USE_MEMORY_DB=false
